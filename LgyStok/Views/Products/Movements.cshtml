@model List<LgyStok.Models.StockMovement>

@{
    ViewBag.Title = "Stok Hareketleri";
}

<h2>Stok Hareketleri: @ViewBag.ProductName</h2>

<p><a href="/Products">Ürünlere dön</a></p>

<table class="table">
    <tr>
        <th>Tarih</th>
        <th>Değişim</th>
        <th>Neden</th>
    </tr>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.CreatedAt</td>
            <td>@m.Change</td>
            <td>@m.Reason</td>
        </tr>
    }
</table>